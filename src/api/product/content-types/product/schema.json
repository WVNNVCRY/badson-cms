{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "priceUSD": {
      "type": "decimal",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "sizing": {
      "type": "component",
      "component": "product.sizing",
      "repeatable": false
    },
    "sizes": {
      "type": "json"
    },
    "details": {
      "type": "json"
    },
    "shippingList": {
      "type": "json"
    },
    "disclaimer": {
      "type": "text"
    },
    "cta": {
      "type": "string"
    },
    "currency": {
      "type": "json"
    }
  }
}
